{
  "name": "@ai-screen-assistant/server",
  "version": "1.0.0",
  "description": "AI Screen Assistant Backend — OpenRouter proxy with streaming, vision, large codegen, continuation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
