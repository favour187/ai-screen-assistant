# Server
PORT=3000
NODE_ENV=development

# OpenRouter — NEVER expose to clients. Set ONLY here and in Render dashboard (Secrets). Never in Android/desktop env.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_APP_URL=https://github.com/your-org/ai-screen-assistant
OPENROUTER_APP_NAME=AI Screen Assistant
# Optional: restrict models (comma-separated, empty = allow any)
OPENROUTER_ALLOWED_MODELS=
# Timeouts & retries for production (large codegen)
OPENROUTER_TIMEOUT_MS=120000
OPENROUTER_STREAM_TIMEOUT_MS=180000
OPENROUTER_MAX_RETRIES=3
OPENROUTER_RETRY_DELAY_MS=800

# CORS — comma-separated allowlist. Use * only for dev. Set to your desktop/Android origins in prod.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5174

# Rate limiting (tiered)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=80
RATE_LIMIT_VISION_MAX=30
RATE_LIMIT_STREAM_MAX=40

# Limits for large vision/codegen
JSON_LIMIT=15mb
URLENCODED_LIMIT=15mb
IMAGE_MAX_BYTES=10485760
MAX_TOKENS_DEFAULT=4096
MAX_TOKENS_MAX=16384
MAX_MESSAGES=50
MAX_PROMPT_CHARS=20000

# Logging
LOG_LEVEL=debug
LOG_PRETTY=true
