# Renderer env (VITE_ prefix required) — backend is attached at build time via environment
# For local dev:
VITE_API_BASE_URL=http://localhost:3000
# For production (Render) — set to your deployed backend, e.g.:
# VITE_API_BASE_URL=https://ai-screen-assistant.onrender.com
VITE_APP_NAME=AI Screen Assistant
